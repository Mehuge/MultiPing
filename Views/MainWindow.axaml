<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiPing.ViewModels"
        x:Class="MultiPing.Views.MainWindow"
        x:DataType="vm:MonitorViewModelBase"
        Width="1200" Height="800"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}">

  <DockPanel>
    <Menu DockPanel.Dock="Top" FontSize="14" Height="24">
      <MenuItem Header="_File">
        <MenuItem Header="New _PlotPing Window" Command="{Binding NewPlotPingWindowCommand}" />
        <MenuItem Header="New _MultiPing Window" Command="{Binding NewMultiPingWindowCommand}" />
        <Separator />
        <MenuItem Header="Open _Log Folder" Command="{Binding OpenLogFolderCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Trace">
        <MenuItem Header="_Start" Command="{Binding StartRunCommand}" />
        <MenuItem Header="Sto_p" Command="{Binding StopRunCommand}" />
      </MenuItem>
      <MenuItem Header="_Options">
        <MenuItem Header="_Options..." Click="OnOptionsClick" />
        <MenuItem Header="_About..." Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <ContentControl Content="{Binding}" />
  </DockPanel>
</Window>
