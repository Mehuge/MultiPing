<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiPing.ViewModels"
        x:Class="MultiPing.Views.AboutDialog"
        Title="About"
        Icon="/Assets/icon.ico"
        Width="480" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Orientation="Horizontal" Margin="10">
    <Image Source="/Assets/logo.png" Width="256" Height="256"/>
    <TextBlock Text="About MultiPing" VerticalAlignment="Center" Margin="10,0,0,0"/>
    </StackPanel>
</Window>