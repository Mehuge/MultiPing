<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MultiPing.ViewModels"
             xmlns:controls="clr-namespace:MultiPing.Controls"
             x:Class="MultiPing.Views.MultiPingView"
             x:DataType="vm:MultiPingViewModel"
             x:CompileBindings="False">

  <UserControl.Styles>
    <Style Selector="FlyoutPresenter.no-padding">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,200,4,*" Margin="6">

    <!-- Toolbar -->
    <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="Add target:" VerticalAlignment="Center" Margin="2,0" />
      <TextBox x:Name="TargetBox" Text="{Binding NewTargetInput}" Width="160" Margin="2,0"
               PlaceholderText="host or IP" KeyDown="OnTargetKeyDown">
        <FlyoutBase.AttachedFlyout>
          <Flyout Placement="Bottom" FlyoutPresenterClasses="no-padding">
            <ListBox x:Name="TargetMruList" ItemsSource="{Binding RecentHosts}" Width="160" MaxHeight="200"
                     Padding="0" Margin="0" BorderThickness="0"
                     SelectionChanged="OnMruSelectionChanged" />
          </Flyout>
        </FlyoutBase.AttachedFlyout>
        <TextBox.InnerLeftContent>
          <Button x:Name="TargetMruButton" Content="▾" FontSize="18" Padding="4,0" Margin="0,0,-8,0" MinWidth="0" MinHeight="0" Background="Transparent"
                  BorderThickness="0" Focusable="False" VerticalContentAlignment="Center" ToolTip.Tip="Recently used hosts"
                  Click="OnMruButtonClick" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Content="Add" Command="{Binding AddTargetCommand}" Margin="2,0" />
      <Button Content="Remove" Command="{Binding RemoveSelectedCommand}" Margin="2,0" />
      <Button Content="{Binding RunButtonText}" Command="{Binding ToggleRunCommand}" Width="70" Margin="10,0" />
      <TextBlock Text="Window (min):" VerticalAlignment="Center" Margin="8,0,2,0" />
      <NumericUpDown Value="{Binding SampleWindowMinutes}" Minimum="1" Maximum="1440" Increment="5" Width="110" Margin="2,0" />
      <TextBlock Text="Interval (s):" VerticalAlignment="Center" Margin="8,0,2,0" />
      <NumericUpDown Value="{Binding PingIntervalSeconds}" Minimum="1" Maximum="60" Increment="1" Width="110" Margin="2,0" />
      <Border Background="{Binding ProbeIndicatorBrush}" CornerRadius="8" Width="35" Padding="6,1" Margin="8,0,8,0" VerticalAlignment="Center"
              ToolTip.Tip="Green 'Ping' while a round is running; otherwise seconds until the next round">
        <TextBlock Text="{Binding ProbeIndicatorText}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
      </Border>
      <Button Content="◀" Command="{Binding ScrollLeftCommand}" Margin="8,0,2,0" ToolTip.Tip="Scroll back in time" />
      <Button Content="Live" Command="{Binding ScrollLiveCommand}" Margin="2,0" ToolTip.Tip="Jump to now" />
      <Button Content="▶" Command="{Binding ScrollRightCommand}" Margin="2,0" ToolTip.Tip="Scroll forward in time" />
      <CheckBox Content="Log to disk" IsChecked="{Binding LoggingEnabled}" Margin="12,0,2,0" VerticalAlignment="Center" />
    </WrapPanel>

    <!-- Top: destination grid (left) + selected-destination traceroute (right) -->
    <Grid Grid.Row="1" ColumnDefinitions="*,4,400" Margin="0,6,0,0">
      <DataGrid Grid.Column="0"
                ItemsSource="{Binding Rows}"
                SelectedItem="{Binding SelectedRow}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                CanUserSortColumns="False"
                CanUserResizeColumns="True"
                GridLinesVisibility="None">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="#" Width="80">
            <DataTemplate x:DataType="vm:ProbeRowViewModel">
              <Border Background="{Binding RttBackground}">
                <TextBlock Text="{Binding Index}" VerticalAlignment="Center" Margin="4,0" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Target" Binding="{Binding Host}" Width="150" />
          <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="150" />
          <DataGridTemplateColumn Header="RTT" Width="70">
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="RTT" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataTemplate x:DataType="vm:ProbeRowViewModel">
              <TextBlock Text="{Binding RttText}" TextAlignment="Right" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Min" Width="70">
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="Min" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataTemplate x:DataType="vm:ProbeRowViewModel">
              <TextBlock Text="{Binding MinText}" TextAlignment="Right" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Max" Width="70">
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="Max" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataTemplate x:DataType="vm:ProbeRowViewModel">
              <TextBlock Text="{Binding MaxText}" TextAlignment="Right" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Avg" Width="70">
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="Avg" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataTemplate x:DataType="vm:ProbeRowViewModel">
              <TextBlock Text="{Binding AvgText}" TextAlignment="Right" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="PL%" Width="70">
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="PL%" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataTemplate x:DataType="vm:ProbeRowViewModel">
              <TextBlock Text="{Binding PlText}" TextAlignment="Right" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Plot" Width="52">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:ProbeRowViewModel">
                <Button Command="{Binding TogglePlotCommand}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="Toggle plot">
                  <Path Width="18" Height="12" Stretch="None"
                        Stroke="#2F9E44" StrokeThickness="1.6" StrokeJoin="Round"
                        Data="M1,11 L6,5 L10,8 L17,1"
                        IsVisible="{Binding PlotEnabled}" />
                </Button>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <GridSplitter Grid.Column="1" Background="#40808080" ResizeDirection="Columns" />

      <Border Grid.Column="2" BorderBrush="#40808080" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="1" FontSize="12" HorizontalAlignment="Center"
                     Text="{Binding SelectedRow.Host, StringFormat='Traceroute: {0}'}" />
          <controls:HopLatencyPlotView x:Name="SnapshotPlot" />
        </DockPanel>
      </Border>
    </Grid>

    <GridSplitter Grid.Row="2" Background="#40808080" ResizeDirection="Rows" HorizontalAlignment="Stretch" />

    <!-- Bottom: one full-width time-series plot per plot-enabled destination, dividing the panel height evenly -->
    <Border Grid.Row="3" Background="#F5F5F0" Padding="2">
      <ItemsControl ItemsSource="{Binding PlottedRows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProbeRowViewModel">
            <controls:LatencyPlotView
                Margin="2"
                Row="{Binding}"
                WindowMinutes="{Binding DataContext.SampleWindowMinutes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                OffsetMinutes="{Binding DataContext.ScrollOffsetMinutes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                PingIntervalMs="{Binding DataContext.PingIntervalMs, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </Grid>
</UserControl>
