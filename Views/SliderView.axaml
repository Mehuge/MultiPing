<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MultiPing.Views"
             xmlns:controls="clr-namespace:MultiPing.Controls"
             xmlns:vm="clr-namespace:MultiPing.ViewModels"
             x:Class="MultiPing.Views.SliderView"
             x:DataType="vm:MonitorViewModelBase">

    <controls:CompactSlider Value="{Binding ScrollOffsetMinutes, Mode=TwoWay}"
                          Maximum="{Binding MaxSliderValue}"
                          IsVisible="{Binding ShouldShowSlider}"
                          Height="12"
                          HorizontalAlignment="Stretch"
                          Margin="2,2"
                          UpdateFrequencyMs="100" />

</UserControl>